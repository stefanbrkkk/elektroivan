{
  "name": "jovan-elektro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mts",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:e2e": "playwright test",
    "lh": "node scripts/lighthouse.mts",
    "og:build": "node scripts/og-build.mts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "gsap": "3.15.0",
    "@gsap/react": "2.1.2",
    "lenis": "1.3.26",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0"
  },
  "devDependencies": {
    "vite": "8.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "22.20.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "10.10.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.70.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "@playwright/test": "1.63.0",
    "lighthouse": "13.4.1"
  }
}
